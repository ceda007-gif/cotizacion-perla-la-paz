rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Uploaded photos: anyone can view, only the signed-in admin can upload/replace.
    match /assets/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ceda007@gmail.com';
    }
  }
}
