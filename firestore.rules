rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Public quote content: anyone can read, only the signed-in admin can write.
    match /content/site {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ceda007@gmail.com';
    }
    match /assets/site {
      allow read: if true;
      allow write: if request.auth != null && request.auth.token.email == 'ceda007@gmail.com';
    }
  }
}
